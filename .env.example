# Set these in Render -> Environment, or use uvicorn main:app --env-file .env locally.
APP_BASE_URL=https://your-app.onrender.com
COOKIE_SECURE=1

# HTTPS email delivery (works with Render Free). Use a verified sender/domain.
EMAIL_FROM=SaveMoney <accounts@your-domain.com>
RESEND_API_KEY=

# Alternative: SMTP on hosts that allow outbound SMTP. STARTTLS on 587, TLS on 465.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# EMAIL_FROM above is also used by SMTP; SMTP_FROM is supported as a fallback.
